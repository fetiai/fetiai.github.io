---
import { classifierDisclaimer } from '../data/projects.js';

/** @type {{ metrics: import('../data/projects.js').ProjectMetrics }} */
const { metrics } = Astro.props;

// Headline the scikit-learn KNN row, then the baseline. The baseline stat is
// mandatory and adjacent: on a 92.5%-imbalanced corpus an accuracy near 0.98
// cannot on its own distinguish a working detector from a constant answer.
const headline = metrics.rows.find((r) => r.model === 'KNN (scikit-learn)');
const pct = (n) => `${(n * 100).toFixed(1)}%`;

const stats = [
  { value: pct(headline.accuracy), label: 'accuracy', note: 'KNN, scikit-learn' },
  { value: headline.recall.toFixed(3), label: 'phishing recall', note: 'the metric that moves' },
  { value: pct(metrics.baseline), label: 'baseline', note: 'constant predictor' },
];
---
<div class="mt-6">
  <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-muted">
    Results <span class="font-normal normal-case tracking-normal">(validation, 28,081 rows)</span>
  </p>

  <dl class="mt-3 grid grid-cols-3 gap-3">
    {stats.map((s) => (
      <div class="rounded-lg bg-surface-2 px-3 py-3 text-center">
        <dd class="text-[1.375rem] font-semibold tabular-nums tracking-[-0.02em] sm:text-[1.5rem]">
          {s.value}
        </dd>
        <dt class="mt-0.5 text-xs font-medium">
          {s.label}
          <span class="mt-0.5 block text-[0.6875rem] font-normal leading-tight text-muted">
            {s.note}
          </span>
        </dt>
      </div>
    ))}
  </dl>

  <p class="mt-3 text-xs leading-relaxed text-muted">
    A constant &ldquo;legitimate&rdquo; predictor scores {pct(metrics.baseline)}. {classifierDisclaimer}
  </p>
</div>
