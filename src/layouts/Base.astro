---
import '../styles/global.css';

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="1JYv9ALT7xMFSB2zBSvprxskJemJgKwqdC8gHhrbDf0" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

  </head>

  <body class="bg-bg text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast"
    >
      Skip to content
    </a>
    <slot />

    <!-- The only JavaScript on the page. It sits after the videos rather than in
         <head>: run any earlier and there are no <video> elements in the DOM yet,
         so it would match nothing. load() restores the poster frame so a
         reduced-motion visitor is left with a still, not a stopped mid-frame.
         The autoplay attribute stays in the markup, so playback still works with
         JavaScript disabled. -->
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const v of document.querySelectorAll('video[autoplay]')) {
          v.removeAttribute('autoplay');
          v.removeAttribute('loop');
          v.pause();
          v.load();
        }
      }
    </script>
  </body>
</html>
